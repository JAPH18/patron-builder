@startuml builder-cours
title Builder : Exemple
hide circle
hide empty members
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 140
skinparam ranksep 70
skinparam class {
  BackgroundColor #E8C880
  BorderColor black
  ArrowColor black
  FontStyle bold
}

class Client {
  +main(String[])
}
class DIRECTEUR {
  +construire()
}
class MonteurPizza {
  +monterPate()
  +monterWSauce()
  +monterGarniture()
  +getPizza()
}
class MonteurPizzaReine {
  +monterPate()
  +monterWSauce()
  +monterGarniture()
}
class MonteurPizzaPiquante {
  +monterPate()
  +monterWSauce()
  +monterGarniture()
}
class Pizza {
  +pate: String
  +sauce: String
  +garniture: String
  +setPate(pate:int)
  +setSauce(sauce:String)
  +setGarniture(garniture:String)
}

Client "0..1" -right-> "0..1" DIRECTEUR : +directeur
DIRECTEUR "1" *-right-> "1..*" MonteurPizza : monteurAbstrait

MonteurPizzaReine -up-|> MonteurPizza
MonteurPizzaPiquante -up-|> MonteurPizza

MonteurPizzaReine .down.> Pizza : <<create>>
MonteurPizzaPiquante .down.> Pizza : <<create>>

' placement
MonteurPizzaReine -[hidden]right- MonteurPizzaPiquante
@enduml
